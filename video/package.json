{
  "name": "article-videos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remotion project that renders the narrated explainer videos embedded in blog posts.",
  "scripts": {
    "studio": "remotion studio",
    "lint:narration": "node scripts/check-narration.mjs",
    "tts": "uv run --project tts python tts/synthesize.py",
    "asr": "uv run --project tts --extra asr python tts/check_asr.py",
    "scenes": "node scripts/scenes.mjs",
    "stills": "node scripts/stills.mjs",
    "sheet": "node scripts/sheet.mjs",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
